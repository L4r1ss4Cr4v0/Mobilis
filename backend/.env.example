# Copie para ".env" (na raiz do backend) e preencha com os dados do Supabase:
# Project Settings > Database > Connect > Session pooler (porta 5432)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=sua-senha-do-banco
